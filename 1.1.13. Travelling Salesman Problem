#include <stdio.h>
#include <limits.h>

#define MAX 15

int n;
int dist[MAX][MAX];
int memo[1 << MAX][MAX];

// Helper function for TSP with Memoization (Bitmask DP)
int tsp(int mask, int pos) {
    // If all cities have been visited, return the cost to return to the start (city 0)
    if (mask == (1 << n) - 1) {
        return (dist[pos][0] == -1) ? 1e9 : dist[pos][0];
    }
    
    if (memo[mask][pos] != -1) {
        return memo[mask][pos];
    }
    
    int ans = 1e9;
    
    for (int city = 0; city < n; city++) {
        // If city is not visited and there is a valid edge
        if ((mask & (1 << city)) == 0 && dist[pos][city] != -1) {
            int newAns = dist[pos][city] + tsp(mask | (1 << city), city);
            if (newAns < ans) {
                ans = newAns;
            }
        }
    }
    
    return memo[mask][pos] = ans;
}

int main() {
    if (scanf("%d", &n) != 1) return 0;
    
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &dist[i][j]);
        }
    }
    
    // Initialize memoization table with -1
    for (int i = 0; i < (1 << n); i++) {
        for (int j = 0; j < n; j++) {
            memo[i][j] = -1;
        }
    }
    
    int result = tsp(1, 0); // Start at city 0 with mask 1 (city 0 visited)
    
    // If result is still infinity, no valid tour exists
    if (result >= 1e9) {
        printf("-1\n");
    } else {
        printf("%d\n", result);
    }
    
    return 0;
}

