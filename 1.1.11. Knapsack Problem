#include <stdio.h>

int max(int a, int b) {
    return (a > b) ? a : b;
}

int main() {
    int n, capacity;

    // Number of items
    scanf("%d", &n);

    int value[n], weight[n];

    // Read values
    for (int i = 0; i < n; i++) {
        scanf("%d", &value[i]);
    }

    // Read weights
    for (int i = 0; i < n; i++) {
        scanf("%d", &weight[i]);
    }

    // Read knapsack capacity
    scanf("%d", &capacity);

    // DP array
    int dp[capacity + 1];

    for (int i = 0; i <= capacity; i++) {
        dp[i] = 0;
    }

    // 0/1 Knapsack
    for (int i = 0; i < n; i++) {
        // Traverse backwards to ensure each item is used only once
        for (int w = capacity; w >= weight[i]; w--) {
            dp[w] = max(dp[w], dp[w - weight[i]] + value[i]);
        }
    }

    // Maximum value
    printf("%d\n", dp[capacity]);

    return 0;
}

